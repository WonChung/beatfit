# Runtime and HTTP configuration. Production startup requires explicit HTTPS
# CORS origins, a non-loopback PostgreSQL URL, and the Supabase URLs below.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOW_CREDENTIALS=true

# Local PostgreSQL development database. Do not commit real credentials.
DATABASE_URL=postgresql+psycopg://beatfit:beatfit_dev@127.0.0.1:5432/beatfit

# Use a separate database for integration tests.
TEST_DATABASE_URL=postgresql+psycopg://beatfit:beatfit_dev@127.0.0.1:5432/beatfit_test

# Supabase Auth verification uses public asymmetric signing keys. No service-role
# key or JWT signing secret is needed by this backend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Optional override; normally derived from SUPABASE_JWT_ISSUER.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Apple Media Services signing credentials are backend-only. Never use these in
# EXPO_PUBLIC_ or NEXT_PUBLIC_ variables and never commit the .p8 file.
APPLE_MUSIC_TEAM_ID=YOUR10CHARTEAMID
APPLE_MUSIC_KEY_ID=YOUR10CHARKEYID
APPLE_MUSIC_MEDIA_ID=com.example.beatfit.music
APPLE_MUSIC_PRIVATE_KEY_PATH=/run/secrets/apple_music_key.p8
# Alternative for secret managers with verified multiline-value handling:
# APPLE_MUSIC_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APPLE_MUSIC_DEVELOPER_TOKEN_TTL_SECONDS=3600
APPLE_MUSIC_API_BASE_URL=https://api.music.apple.com
APPLE_MUSIC_WEB_ORIGINS=http://localhost:3000
