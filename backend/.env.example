# Local PostgreSQL development database. Do not commit real credentials.
DATABASE_URL=postgresql+psycopg://beatfit:beatfit_dev@127.0.0.1:5432/beatfit

# Use a separate database for integration tests.
TEST_DATABASE_URL=postgresql+psycopg://beatfit:beatfit_dev@127.0.0.1:5432/beatfit_test

# Supabase Auth verification uses public asymmetric signing keys. No service-role
# key or JWT signing secret is needed by this backend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Optional override; normally derived from SUPABASE_JWT_ISSUER.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
