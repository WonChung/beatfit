# Browser-accessible API endpoint. This value is embedded at build time.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable/anonymous key only. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Non-secret UI configuration only. Developer tokens come from FastAPI.
NEXT_PUBLIC_APPLE_MUSIC_ENABLED=false
NEXT_PUBLIC_APPLE_MUSIC_DEFAULT_STOREFRONT=us
# Spotify client ID is public. Never add a Spotify client secret to browser configuration.
NEXT_PUBLIC_SPOTIFY_ENABLED=false
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id
# Must exactly match a Spotify Developer Dashboard redirect URI.
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback
