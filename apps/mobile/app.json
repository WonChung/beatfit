{
  "expo": {
    "name": "BeatFit",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/beatfit-app-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/beatfit-app-icon.png",
      "bundleIdentifier": "com.beatfit.mobile",
      "infoPlist": {
        "NSAppleMusicUsageDescription": "BeatFit uses your Apple Music library so you can select songs for workouts."
      }
    },
    "android": {
      "package": "com.beatfit.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#101218",
        "foregroundImage": "./assets/brand/beatfit-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/beatfit-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101218",
          "image": "./assets/brand/beatfit-mark.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
