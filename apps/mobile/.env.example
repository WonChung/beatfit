# Local web and iOS Simulator fallback. For a physical phone, replace
# 127.0.0.1 with your Mac's local network IP (for example, 192.168.1.25).
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable/anonymous key only. Never put a service-role key here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Feature visibility only. No Apple developer token or signing key belongs here.
EXPO_PUBLIC_APPLE_MUSIC_ENABLED=false
# Public OAuth client configuration. Never place a Spotify client secret here.
EXPO_PUBLIC_SPOTIFY_ENABLED=false
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=mobile://spotify-callback
